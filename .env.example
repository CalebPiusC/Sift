# Local Docker only. Replace with a long random value before running Compose.
POSTGRES_PASSWORD=replace-with-a-local-password

# Optional operator/test tooling reads exported environment variables, not this
# file automatically. Keep these unset for the no-account sample frontend.
# SUPABASE_TEST_DATABASE_URL=      # staging rollback-only hosted RLS test
# MONITOR_API_ORIGIN=https://api.example.invalid
# OPERATOR_BEARER=                # short-lived session; inject securely, never Git
# PGSERVICE=selvora_backup        # service in a protected pg_service.conf
# PGSERVICEFILE=/secure/path/pg_service.conf
# BACKUP_DIR=/secure/encrypted/backups
# BACKUP_FILE=/secure/encrypted/backups/selected.dump
# CONFIRM_ISOLATED_RESTORE=RESTORE_TO_ISOLATED_DATABASE
# SELVORA_TEST_URL=http://localhost:3001
# RECEIPT_PDF_OUTPUT=/tmp/selvora-sample-receipt.pdf
