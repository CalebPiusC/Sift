{
  "name": "selvora",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "test": "npm run test -w web",
    "typecheck": "npm run typecheck -w web",
    "test:db": "node --test tests/rls.test.mjs",
    "test:pwa": "node --test tests/pwa.test.mjs",
    "test:all": "npm test && npm run test:db && npm run test:db:native && npm run test:pwa && npm run test:security && npm run typecheck && npm run test:contract",
    "format": "prettier --write web tests/*.mjs package.json docker-compose.yml",
    "test:db:native": "node --test tests/native-postgres.test.mjs",
    "test:db:supabase": "node scripts/test-supabase-rls.mjs",
    "test:security": "node --test tests/browser-env.test.mjs",
    "check:browser-env": "node scripts/check-browser-env.mjs",
    "docs:contract": "node scripts/write-api-contract.mjs",
    "test:contract": "node --test tests/contract-doc.test.mjs",
    "test:mobile": "node tests/inbox-mobile.mjs",
    "test:orders:mobile": "node tests/orders-mobile.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@sparticuz/chromium": "^153.0.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "pg": "^8.23.1",
    "playwright-core": "^1.65.0",
    "prettier": "^3.9.10"
  }
}
