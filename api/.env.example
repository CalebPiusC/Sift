SUPABASE_URL=
SUPABASE_ANON_KEY=
WEB_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql://selvora:YOUR_LOCAL_PASSWORD@localhost:5432/selvora
REDIS_URL=redis://localhost:6379/0

# B2 opt-in. DATABASE_URL must use a dedicated LOGIN NOINHERIT NOSUPERUSER
# NOBYPASSRLS role granted selvora_service; never use postgres/service_role.
PIPELINE_ENABLED=false
# JSON keyring of URL-safe base64 32-byte keys, retained during rotation.
PIPELINE_KEYS={}
PIPELINE_KEY_VERSION=v1
# Independent stable URL-safe base64 secret, at least 32 bytes. Do not rotate casually.
IDENTITY_PEPPER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public HTTPS callback routed to /v1/channels/oauth/gmail/callback
GOOGLE_REDIRECT_URI=
GMAIL_PUBSUB_TOPIC=
GMAIL_PUSH_AUDIENCE=
GMAIL_PUSH_SERVICE_ACCOUNT=
PIPELINE_LEASE_SECONDS=90
WORKER_POLL_SECONDS=2

# B4: server-only Paystack merchant secret (sk_test_... for staging), never browser env.
PAYSTACK_SECRET_KEY=
# Public HTTPS web origin used to host signed receipt links.
PUBLIC_WEB_URL=

# B5. Sandbox uses the same Cloud API adapter with a fake HTTP transport.
# Sandbox never calls Meta/Gemini; signed webhooks still require locally chosen secrets.
WHATSAPP_MODE=sandbox
META_GRAPH_VERSION=v23.0
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_SIGNUP_CONFIG_ID=
WHATSAPP_HELPER_PHONE_ID=
WHATSAPP_HELPER_NUMBER=
WHATSAPP_HELPER_TOKEN=
GEMINI_API_KEY=
GEMINI_AUDIO_MODEL=gemini-2.5-flash

# B8: optional per-million token USD rates for GEMINI_AUDIO_MODEL. Leave unset
# until pricing is reviewed; missing rates are reported as unknown, not zero.
# AI_INPUT_USD_PER_MILLION=
# AI_OUTPUT_USD_PER_MILLION=
AI_PRICING_VERSION=unconfigured

# B9: enable before live launch; Redis must be available (failure returns 503).
RATE_LIMIT_ENABLED=false
API_REQUESTS_PER_MINUTE=120
WEBHOOK_REQUESTS_PER_MINUTE=1200
# Supabase user UUIDs for global operator endpoints, not vendor membership roles.
OPERATOR_USER_IDS=[]
QUEUE_ALERT_SECONDS=300
EMAIL_API_KEY=
EMAIL_FROM=
