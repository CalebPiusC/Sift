# Next loads web/.env.local when run via the web workspace. Safe no-account demo:
# keep DATA_MODE=mock and both Supabase values blank. No API origin is needed.
# Supabase project settings > API. Publishable / anon key, never a privileged server key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-read switch; mock never calls real services. api never falls back to samples.
DATA_MODE=mock
# Server-side only. Next proxies /api/v1/* to this FastAPI origin.
# For local development, http://127.0.0.1:8000; browser never calls localhost.
API_ORIGIN=
